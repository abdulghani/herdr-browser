{
  "name": "herdr-browser",
  "productName": "Herdr Browser",
  "version": "0.3.8",
  "description": "Chromium browser with herdr-style layout: vertical workspaces, horizontal tabs inside each",
  "type": "module",
  "main": "dist-main/main.cjs",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run build:ui && npm run build:main",
    "build:ui": "vite build",
    "build:main": "vite build --config vite.main.config.ts",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "dist": "npm run build && electron-builder --linux AppImage",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --x64"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "desktopName": "herdr-browser.desktop",
  "build": {
    "appId": "dev.herdr.browser",
    "files": [
      "dist-main/**/*",
      "dist-ui/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network;WebBrowser",
      "artifactName": "HerdrBrowser-${version}-${arch}.AppImage",
      "desktop": {
        "entry": {
          "StartupWMClass": "herdr-browser",
          "MimeType": "x-scheme-handler/http;x-scheme-handler/https;text/html;"
        }
      },
      "syncDesktopName": true,
      "executableName": "herdr-browser"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web site URL",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ]
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "public.html",
              "public.xhtml"
            ]
          }
        ]
      },
      "identity": "-",
      "target": [
        "dmg"
      ],
      "artifactName": "HerdrBrowser-${version}-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Herdr Browser ${version}"
    }
  },
  "allowScripts": {
    "electron-winstaller": false,
    "fsevents": false
  }
}

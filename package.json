{
  "name": "herdr-browser",
  "productName": "Herdr Browser",
  "version": "0.3.6",
  "description": "Experimental Electrobun (native WebKit) build of Herdr Browser: herdr-style layout with vertical workspaces and horizontal tabs inside each",
  "main": "src/main.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build:ui": "vite build",
    "build:icons": "scripts/make-iconset.sh",
    "start": "electrobun prepare && npm run build:ui && npm run build:icons && electrobun dev",
    "dev": "npm run start",
    "build": "electrobun prepare && npm run build:ui && npm run build:icons && electrobun build --env=stable",
    "dist:mac": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electrobun": "2.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "fsevents": false
  }
}

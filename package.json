{
  "name": "herdr-browser",
  "productName": "Herdr Browser",
  "version": "0.3.2",
  "description": "Chromium browser with herdr-style layout: vertical workspaces, horizontal tabs inside each",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  },
  "desktopName": "herdr-browser.desktop",
  "build": {
    "appId": "dev.herdr.browser",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network;WebBrowser",
      "artifactName": "HerdrBrowser-${version}-${arch}.AppImage",
      "desktop": {
        "entry": {
          "StartupWMClass": "herdr-browser",
          "MimeType": "x-scheme-handler/http;x-scheme-handler/https;text/html;"
        }
      },
      "syncDesktopName": true,
      "executableName": "herdr-browser"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web site URL",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ]
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "public.html",
              "public.xhtml"
            ]
          }
        ]
      },
      "identity": "-",
      "target": [
        "dmg"
      ],
      "artifactName": "HerdrBrowser-${version}-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Herdr Browser ${version}"
    }
  }
}
